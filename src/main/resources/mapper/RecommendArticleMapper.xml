<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mata.model.article.dao.RecommendArticleDao">


    <select id="getAllRecommendArticle" resultType="com.mata.model.article.vo.RecommendArticleVo">
        SELECT a.article_id,a.article_img_url,a.article_title
        FROM tb_recommend_article r JOIN tb_article a
                                         ON r.article_id = a.article_id

    </select>
</mapper>